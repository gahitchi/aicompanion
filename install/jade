#!/usr/bin/env bash
# Jade launcher wrapper. Activates the project venv and runs launcher.py.
# Install to ~/.local/bin/jade and chmod +x.
#
# Usage:
#   jade                  # voice-only headless (default for the wrapper)
#   jade --interactive    # tk window + voice + tray
#   jade --no-welcome     # skip startup greeting
#
# Env vars (all optional):
#   JADE_HOME             — project root (default: ~/Desktop/aicompanion)
#   JADE_VENV             — venv name under JADE_HOME (default: .venv312)
#   OLLAMA_MODEL          — Ollama model tag (default: per llm.py)
#   WHISPER_CPU=1         — force Whisper on CPU (frees VRAM for larger LLMs)
#   KOKORO_VOICE          — Kokoro speaker override

set -euo pipefail

JADE_HOME="${JADE_HOME:-$HOME/Desktop/aicompanion}"
JADE_VENV="${JADE_VENV:-.venv312}"

if [[ ! -d "$JADE_HOME" ]]; then
    echo "Jade home not found at $JADE_HOME. Set JADE_HOME env or move the project." >&2
    exit 1
fi
if [[ ! -f "$JADE_HOME/$JADE_VENV/bin/activate" ]]; then
    echo "venv not found at $JADE_HOME/$JADE_VENV. Set JADE_VENV env or create it." >&2
    exit 1
fi

cd "$JADE_HOME"
# shellcheck disable=SC1091
source "$JADE_VENV/bin/activate"

# Default to voice-only headless unless caller opts into interactive mode.
mode_flag="--voice-only"
forwarded=()
for arg in "$@"; do
    case "$arg" in
        --interactive) mode_flag="";;
        *) forwarded+=("$arg");;
    esac
done

exec python launcher.py $mode_flag "${forwarded[@]}"
