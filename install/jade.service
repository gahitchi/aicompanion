[Unit]
Description=Jade — voice-first AI companion
# Wait for the graphical session so PulseAudio / PipeWire are up.
After=graphical-session.target sound.target
Wants=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.local/bin/jade
Restart=on-failure
RestartSec=10

# Inherit the graphical environment (PulseAudio socket, display vars, etc.).
# These are typically already set in the user session; passthrough is a
# safety net in case systemd's user manager doesn't see them.
Environment=PULSE_RUNTIME_PATH=%t/pulse
Environment=XDG_RUNTIME_DIR=%t

# Unbuffered Python stdout/stderr so journalctl sees output in real time
# instead of in 8KB chunks.
Environment=PYTHONUNBUFFERED=1

# Override these to tune VRAM / model.
Environment=OLLAMA_MODEL=qwen2.5:7b-instruct
Environment=WHISPER_CPU=1

# Log to journalctl --user -u jade.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
